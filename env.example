GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database — libSQL. Leave both blank for local file (file:./db/hoodtopia.db).
# In production / Vercel, point at a Turso DB:
#   turso db create hoodtopia
#   turso db show hoodtopia --url        → TURSO_DATABASE_URL
#   turso db tokens create hoodtopia     → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Kustom Checkout — server-only, never NEXT_PUBLIC_*
# Get credentials from https://portal.playground.kustom.co/onboarding
KUSTOM_API_BASE_URL=https://api.playground.kustom.co
KUSTOM_USERNAME=                       # MID-<randomsuffix> from portal (optional with API key)
KUSTOM_API_KEY=                        # kco_test_api_...
KUSTOM_MERCHANT_ID=

# Used to build merchant_urls (push, confirmation, terms). Must be publicly reachable for push to work.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kustom Shipping Assistant (Commit 2) — shared with KSA via Kustom Portal config
KUSTOM_SHIPPING_KEY=                   # shared secret KSA hashes with nonce (sha256)
KUSTOM_SHIPPING_JWT_SECRET=            # HS256 signing secret for our bearer token

# Kustom Checkout Callbacks — when set, /api/kustom/callbacks/* routes are
# advertised in merchant_urls and protected by an HMAC-derived ?token=. Leave
# blank to disable callbacks (Kustom falls back to its own defaults).
# Generate with: openssl rand -hex 32
KUSTOM_CALLBACK_SECRET=                # HMAC secret for protecting callback URLs

# Upsell activation mode:
#   per-order (default) → confirmation_page_upsell=true on every create-order
#   global              → omit the flag, enable upsell globally in the Portal
#   off                 → never fire upsells even if the callback URL is set
KUSTOM_UPSELL_MODE=per-order

# Authenticated REST upsell endpoint (POST /api/upsell) — a Bearer-JWT sibling
# of the Kustom confirmation-page callback, for fetching upsell recommendations
# directly (e.g. while onboarding/testing the upsell experience). Both must be
# set to enable the endpoint; leave blank and /api/upsell* return 401/503.
# Generate each with: openssl rand -hex 32
UPSELL_API_KEY=                        # shared credential clients hash with a nonce
UPSELL_API_JWT_SECRET=                 # server-only HS256 signing secret (min 32 chars)

# Kustom On-site Elements — both vars come from the install snippet in the
# Kustom Portal (Elements section). Add hoodtopia.co + your dev domains to
# the Allowed Domains list in the same portal screen.
NEXT_PUBLIC_KUSTOM_ELEMENTS_SRC=       # e.g. https://js.live.kustom.co/kustom-elements/v1/pre-load.js
NEXT_PUBLIC_KUSTOM_ELEMENTS_API_KEY=   # the data-public-api-key from the snippet

# ── MedusaJS commerce backend ────────────────────────────────────────────────
# The storefront reads products/cart/orders from Medusa. Backend runs locally
# on :9010 (a pimir-minio container squats :9000); prod uses api.hoodtopia.co.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9010
# Publishable key — printed by `npm run seed` in medusa/. Scopes the Store API.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=    # pk_...
# Server-only admin secret key for one-off writes (custom AI-design products).
# Printed by `npm run seed:extras` in medusa/. NEVER prefix with NEXT_PUBLIC_.
MEDUSA_ADMIN_API_KEY=                  # sk_...
