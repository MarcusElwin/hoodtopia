# ─────────────────────────────────────────────────────────────────────────────
# Hoodtopia Medusa backend — environment template
# Copy to `.env` and fill in. `.env` is gitignored; this template is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection. Medusa only supports Postgres.
# Local (docker-compose `db` service): postgres://medusa:medusa@localhost:5432/medusa
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa

# Optional. When set, the cache / event bus / workflow engine run on Redis
# instead of the in-memory fakes. Leave empty for local dev.
# REDIS_URL=redis://localhost:6379

# CORS allow-lists (comma-separated origins, or a /regex/).
# Dev: storefront on :3000, admin served by this server on :9000.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000

# Secrets for signing JWTs and cookies. Generate strong random values for prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# URL the bundled admin dashboard calls back to. Local default below.
# Prod: https://api.hoodtopia.co
MEDUSA_BACKEND_URL=http://localhost:9000

# ── Production reference (Fly.io) — see docs/MEDUSA_INTEGRATION.md ───────────
# DATABASE_URL=postgres://...@<fly-postgres-host>:5432/medusa
# REDIS_URL=redis://<upstash-host>:6379
# STORE_CORS=https://hoodtopia.co
# ADMIN_CORS=https://admin.hoodtopia.co
# AUTH_CORS=https://hoodtopia.co,https://admin.hoodtopia.co
# MEDUSA_BACKEND_URL=https://api.hoodtopia.co
